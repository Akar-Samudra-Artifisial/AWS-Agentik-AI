# Base URL API ResolveAI (API Gateway) termasuk prefix /api, tanpa slash akhir.
NEXT_PUBLIC_API_BASE_URL=https://xxxxxxxx.execute-api.ap-southeast-1.amazonaws.com/api
# Shared API key demo. PERINGATAN: semua NEXT_PUBLIC_* tertanam di bundle JS (terlihat publik).
NEXT_PUBLIC_API_KEY=
# Nomor demo E.164 untuk Simulator (sama dengan DEMO_PHONE_E164 backend). Opsional.
NEXT_PUBLIC_DEMO_PHONE_E164=
# Nama pelanggan demo yang tampil di Simulator. Opsional.
NEXT_PUBLIC_DEMO_CUSTOMER_NAME=Rani (demo)
# Identitas staf yang dicatat sebagai decided_by saat approve/reject.
NEXT_PUBLIC_STAFF_NAME=Supervisor
